#!/bin/sh
# Stands in for the vivado binary so the whole measurement path can be
# exercised where no Vivado is installed. It runs the real TCL script under
# tclsh with stubbed tool commands, which checks everything except whether
# Vivado agrees with the numbers.
here=$(cd "$(dirname "$0")" && pwd)
case "$1" in
  -version|--version)
    echo "Vivado v0.0 (stub, tests/fake_vivado)"
    exit 0
    ;;
esac
exec tclsh "$here/vivado_stub.tcl" "$@"
